    "/api/v2/telemetry/vessels/{mmsi}/readings": {
      "get": {
        "description": "Ascending in time; `[from, to)`; buckets whose start lies in the range. Hourly and daily sums come from the continuous aggregates: readings stored more than an hour after their time (store and forward, imports) are included after the next refresh (fuel_hourly every 15 min, fuel_daily hourly).",
        "operationId": "ReadingsController_series",
        "parameters": [
          {
            "name": "mmsi",
            "required": true,
            "in": "path",
            "description": "9-digit MMSI",
            "schema": {
              "example": 525005223,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from `page.nextCursor` of the previous page",
            "schema": {
              "maxLength": 1024,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 500,
              "default": 100,
              "type": "integer"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Start (ISO-8601); default: endpoint specific",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "End (ISO-8601); default: now",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "bucket",
            "required": false,
            "in": "query",
            "description": "`raw` readings (default range 24 h, at most 31 d), `1h` hourly sums (7 d, ≤ 366 d) or `1d` daily sums (365 d, ≤ 5 y); buckets are UTC and come from the continuous aggregates fuel_hourly / fuel_daily",
            "schema": {
              "default": "raw",
              "type": "string",
              "enum": [
                "raw",
                "1h",
                "1d"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the time-ordered list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "page"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FuelSeriesPointDto"
                      }
                    },
                    "page": {
                      "$ref": "#/components/schemas/CursorPageInfoDto"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Readings of a vessel, raw or as hourly / daily sums",
        "tags": [
          "readings"
        ],
        "x-required-permissions": [
          "telemetry:read"
        ]
      }
    },
    "/api/v2/telemetry/vessels/{mmsi}/summary": {
      "get": {
        "description": "Readings with time in `[from, to)` (default: the last 30 days, at most 5 years): whole UTC days from fuel_daily, whole hours from fuel_hourly, the edges from the raw readings (late readings: see the readings endpoint).",
        "operationId": "ReadingsController_summary",
        "parameters": [
          {
            "name": "mmsi",
            "required": true,
            "in": "path",
            "description": "9-digit MMSI",
            "schema": {
              "example": 525005223,
