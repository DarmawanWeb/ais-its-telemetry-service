              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FuelSummaryDto"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Fuel totals of a vessel over a time range",
        "tags": [
          "readings"
        ],
        "x-required-permissions": [
          "telemetry:read"
        ]
      }
    },
    "/api/v2/telemetry/vessels/{mmsi}/status": {
      "get": {
        "description": "Active = newest reading at most TELEMETRY_ACTIVE_WINDOW_MIN minutes old.",
        "operationId": "ReadingsController_status",
