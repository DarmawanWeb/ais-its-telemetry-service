    "/api/v2/telemetry/readings": {
      "post": {
        "description": "All or nothing: every reading is validated (non-negative, ≤ configured maxima, time ≤ now + TELEMETRY_MAX_FUTURE_SKEW_MIN and at most TELEMETRY_MAX_AGE_DAYS old, periodStart before time) and every vessel must belong to the caller’s organization before anything is stored. A vessel has one reading per time: an exact repeat (same period, amounts and device) is an idempotent duplicate; a different reading at a stored (mmsi, time) — other values, or another device of the vessel — answers 409 READING_CONFLICT and nothing of the request is stored. Stored readings are published as fuel.reading.recorded.v1 after the commit (Nats-Msg-Id <mmsi>:<time>). Error fields are `<index>.<field>`.",
        "operationId": "ReadingsController_ingest",
        "parameters": [
          {
            "name": "source",
            "required": false,
            "in": "query",
            "description": "Signed-in users only: `manual` entries or an `import` of historical data. API keys are attributed automatically (`device` for the key of a registered http device, else `api`).",
            "schema": {
              "default": "manual",
              "type": "string",
              "enum": [
                "manual",
                "import"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/FuelReadingInputDto"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "$ref": "#/components/schemas/FuelReadingInputDto"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResultDto"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "summary": "Ingest fuel readings (one object or an array of ≤ 1000)",
        "tags": [
          "readings"
        ],
        "x-api-key-scopes": [
          "telemetry:ingest"
        ],
        "x-required-permissions": [
          "telemetry:write"
        ]
      }
    },
