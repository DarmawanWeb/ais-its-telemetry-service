# ais-its-telemetry-service — every variable the service reads (docs/PLATFORM_SPEC.md §4).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=telemetry
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3005
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "telemetry" ---------------------
DATABASE_URL=postgres://telemetry_svc:telemetry_svc@localhost:5432/aisits
DATABASE_SCHEMA=telemetry
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed. The same server runs the MQTT gateway (port 1883):
# fuel meters publish to MQTT topic aisits/telemetry/<deviceId>, which this service
# receives on the core subject aisits.telemetry.<deviceId> (queue group = SERVICE_NAME).
NATS_URL=nats://localhost:4222
# Prefix of durable consumer names (empty in deployments; test suites set one).
# NATS_DURABLE_PREFIX=

# --- Valkey (part of the base schema; this service does not use Valkey) ------------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-* headers are trusted (default: loopback and private networks).
# TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# --- Telemetry (docs/PLATFORM_SPEC.md §13.4) --------------------------------------
# Telemetry of a vessel is "active" while its newest reading is at most this old, minutes
# (method fuel.method_selection; the legacy window was 10 s by a unit bug, spec §15.5).
TELEMETRY_ACTIVE_WINDOW_MIN=10
# Plausibility rules of every reading (REST and MQTT):
# how far a reading may lie ahead of the server clock, minutes (0–60)
TELEMETRY_MAX_FUTURE_SKEW_MIN=5
# how old a reading may be, days (1–1825, at most the 5-year retention of fuel_readings)
TELEMETRY_MAX_AGE_DAYS=1825
# largest main / auxiliary engine fuel of one reading, tonnes
TELEMETRY_MAX_FUEL_ME_TON=500
TELEMETRY_MAX_FUEL_AE_TON=100
# longest measured period (time − periodStart), hours (1–744)
TELEMETRY_MAX_PERIOD_H=24
# Publication of fuel.reading.recorded.v1: JetStream ack timeout of one publish, ms.
TELEMETRY_PUBLISH_TIMEOUT_MS=5000
# Publication relay: poll interval (ms, 0 disables the relay), grace period after which a
# stored but unpublished reading is republished (s), readings per relay transaction.
TELEMETRY_RELAY_INTERVAL_MS=5000
TELEMETRY_RELAY_AFTER_S=30
TELEMETRY_RELAY_BATCH_SIZE=500

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
