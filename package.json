{
  "name": "ais-its-telemetry-service",
  "version": "0.2.0",
  "private": true,
  "description": "Fuel consumption telemetry: readings ingest over REST and MQTT, device registry, queries and status; publishes fuel.reading.recorded.v1",
  "displayName": "AIS ITS Telemetry Service",
  "license": "UNLICENSED",
  "author": "DarmawanWeb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarmawanWeb/ais-its-telemetry-service.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "NODE_ENV=production node --enable-source-maps dist/main.js",
    "migrate": "node --enable-source-maps dist/migrate.js",
    "openapi": "pnpm run build && node --enable-source-maps dist/openapi.js",
    "openapi:check": "node --enable-source-maps dist/openapi.js --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:all": "pnpm run test && pnpm run test:int",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"for (const p of ['dist', 'coverage']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@darmawanweb/ais-its-contracts": "^0.4.0",
    "@darmawanweb/ais-its-nest": "^0.3.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mqtt": "^5.16.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "testcontainers": "^12.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
